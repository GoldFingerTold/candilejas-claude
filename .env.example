# Copiá este archivo a .env y completá los valores antes de arrancar el servidor.

# Puerto donde corre el sitio
PORT=3000

# Connection string de MongoDB Atlas (Project → Build a Database → plan Free/M0 →
# Connect → Drivers). Reemplazá <db_password> por la contraseña real del usuario de la
# base y agregale el nombre de la base después del host, ej:
# mongodb+srv://candilejas:TU_PASSWORD@cluster0.xxxxx.mongodb.net/candilejas?retryWrites=true&w=majority
MONGODB_URI=

# Credenciales de Cloudinary (cloudinary.com, plan gratis) para las fotos que se suben
# desde el panel - se ven en el Dashboard al entrar. El disco de la app tampoco
# sobrevive a un redeploy, así que las imágenes subidas necesitan vivir afuera.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contraseña del panel de administración (se usa solo la primera vez que arranca el
# servidor, para crear el usuario admin en la base - después cambiala desde el panel).
ADMIN_PASSWORD=cambiar-esta-clave

# Cadena secreta para firmar la cookie de sesión del panel. Poné cualquier texto largo
# y aleatorio, distinto en cada instalación.
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Solo hace falta si el frontend (carpeta public/) se sirve desde un dominio DISTINTO al
# de este backend. Dejalo comentado/vacío si todo corre en el mismo dominio.
# CORS_ORIGIN=https://eventoscandilejas.com.ar,https://www.eventoscandilejas.com.ar

# Clave de recuperación de emergencia: si alguna vez se pierde la contraseña del panel,
# desde "¿Olvidaste tu contraseña?" en /admin se puede resetear usando esta clave - la
# contraseña queda igual a lo que tenga ADMIN_PASSWORD en ese momento. Dejala sin definir
# para deshabilitar esta vía por completo.
# ADMIN_RECOVERY_KEY=
